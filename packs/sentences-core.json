   "category": "Höflichkeit",
   "hint": null,
   "lesson": "l-0105"
  },
  {
   "id": "s-0034",
   "nl": "Met alle plezier.",
   "de": "Sehr gerne.",
   "category": "Höflichkeit",
   "hint": null,
   "lesson": "l-0105"
  },
  {
