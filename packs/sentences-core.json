   "category": "Höflichkeit",
   "hint": null,
   "lesson": "l-0105"
  },
  {
   "id": "s-0031",
   "nl": "Neem me niet kwalijk.",
   "de": "Entschuldigen Sie bitte.",
   "category": "Höflichkeit",
   "hint": "formell",
   "lesson": "l-0105"
  },
  {
   "id": "s-0032",
   "nl": "Geeft niks.",
   "de": "Macht nichts.",
   "category": "Höflichkeit",
   "hint": null,
   "lesson": "l-0105"
  },
  {
   "id": "s-0033",
   "nl": "Geen probleem.",
