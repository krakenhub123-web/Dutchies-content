 "sentences": [
  {
   "id": "s-0001",
   "nl": "Hoi! / Hallo!",
   "de": "Hallo!",
   "category": "Begrüßen & Verabschieden",
   "hint": "informell",
   "lesson": "l-0101"
  },
  {
   "id": "s-0002",
   "nl": "Goedemorgen.",
   "de": "Guten Morgen.",
   "category": "Begrüßen & Verabschieden",
   "hint": null,
   "lesson": "l-0101"
  },
  {
   "id": "s-0003",
   "nl": "Goedemiddag.",
   "de": "Guten Tag.",
   "category": "Begrüßen & Verabschieden",
   "hint": "ab etwa 12 Uhr",
   "lesson": "l-0101"
  },
  {
   "id": "s-0004",
   "nl": "Goedenavond.",
   "de": "Guten Abend.",
   "category": "Begrüßen & Verabschieden",
   "hint": null,
   "lesson": "l-0101"
  },
  {
   "id": "s-0005",
   "nl": "Hoe gaat het?",
   "de": "Wie geht's?",
   "category": "Begrüßen & Verabschieden",
   "hint": null,
   "lesson": "l-0101"
  },
  {
   "id": "s-0006",
   "nl": "Hoe gaat het met u?",
   "de": "Wie geht es Ihnen?",
   "category": "Begrüßen & Verabschieden",
   "hint": "formell (u)",
   "lesson": "l-0101"
  },
  {
   "id": "s-0007",
   "nl": "Goed, en met jou?",
   "de": "Gut, und dir?",
   "category": "Begrüßen & Verabschieden",
   "hint": null,
   "lesson": "l-0101"
  },
  {
   "id": "s-0008",
   "nl": "Prima, dank je.",
   "de": "Prima, danke.",
   "category": "Begrüßen & Verabschieden",
   "hint": null,
   "lesson": "l-0101"
  },
  {
   "id": "s-0009",
   "nl": "Het gaat wel.",
   "de": "Es geht so.",
   "category": "Begrüßen & Verabschieden",
   "hint": null,
   "lesson": "l-0102"
  },
  {
   "id": "s-0010",
   "nl": "Alles goed?",
   "de": "Alles gut?",
   "category": "Begrüßen & Verabschieden",
   "hint": "sehr gängige Begrüßung; Antwort: „Ja, prima!“",
   "lesson": "l-0102"
  },
  {
   "id": "s-0011",
   "nl": "Gaat 'ie?",
   "de": "Alles klar?",
   "category": "Begrüßen & Verabschieden",
   "hint": "sehr umgangssprachlich",
   "lesson": "l-0102"
  },
  {
   "id": "s-0012",
   "nl": "Lang niet gezien!",
   "de": "Lange nicht gesehen!",
   "category": "Begrüßen & Verabschieden",
   "hint": null,
   "lesson": "l-0102"
  },
  {
   "id": "s-0013",
   "nl": "Leuk je te ontmoeten.",
   "de": "Schön, dich kennenzulernen.",
   "category": "Begrüßen & Verabschieden",
   "hint": null,
   "lesson": "l-0102"
  },
  {
   "id": "s-0014",
   "nl": "Doei! / Doeg!",
   "de": "Tschüss!",
   "category": "Begrüßen & Verabschieden",
   "hint": "informell",
   "lesson": "l-0102"
  },
  {
   "id": "s-0015",
   "nl": "Tot ziens.",
   "de": "Auf Wiedersehen.",
   "category": "Begrüßen & Verabschieden",
   "hint": null,
   "lesson": "l-0102"
  },
  {
   "id": "s-0016",
   "nl": "Tot straks.",
   "de": "Bis später.",
   "category": "Begrüßen & Verabschieden",
   "hint": "man sieht sich noch am selben Tag",
   "lesson": "l-0102"
  },
  {
   "id": "s-0017",
   "nl": "Tot zo.",
   "de": "Bis gleich.",
   "category": "Begrüßen & Verabschieden",
   "hint": null,
   "lesson": "l-0103"
  },
  {
   "id": "s-0018",
   "nl": "Tot morgen.",
   "de": "Bis morgen.",
   "category": "Begrüßen & Verabschieden",
   "hint": null,
   "lesson": "l-0103"
  },
  {
   "id": "s-0019",
   "nl": "Fijne dag nog!",
   "de": "Noch einen schönen Tag!",
   "category": "Begrüßen & Verabschieden",
   "hint": null,
   "lesson": "l-0103"
  },
  {
   "id": "s-0020",
   "nl": "Fijn weekend!",
   "de": "Schönes Wochenende!",
   "category": "Begrüßen & Verabschieden",
   "hint": null,
   "lesson": "l-0103"
  },
  {
   "id": "s-0021",
   "nl": "Welterusten.",
   "de": "Gute Nacht. / Schlaf gut.",
   "category": "Begrüßen & Verabschieden",
   "hint": "nur vor dem Schlafengehen",
   "lesson": "l-0103"
  },
  {
   "id": "s-0022",
   "nl": "De groeten aan …",
   "de": "Grüße an …",
   "category": "Begrüßen & Verabschieden",
   "hint": null,
   "lesson": "l-0103"
  },
  {
   "id": "s-0023",
   "nl": "Dank je wel.",
   "de": "Vielen Dank.",
   "category": "Höflichkeit",
   "hint": "informell (je)",
   "lesson": "l-0104"
  },
  {
   "id": "s-0024",
   "nl": "Dank u wel.",
   "de": "Vielen Dank.",
   "category": "Höflichkeit",
   "hint": "formell (u)",
   "lesson": "l-0104"
  },
  {
   "id": "s-0025",
   "nl": "Bedankt!",
   "de": "Danke!",
   "category": "Höflichkeit",
   "hint": null,
   "lesson": "l-0104"
  },
  {
   "id": "s-0026",
   "nl": "Graag gedaan.",
   "de": "Gern geschehen.",
   "category": "Höflichkeit",
   "hint": null,
   "lesson": "l-0104"
  },
  {
   "id": "s-0027",
   "nl": "Geen dank.",
   "de": "Keine Ursache.",
   "category": "Höflichkeit",
   "hint": null,
   "lesson": "l-0104"
  },
  {
   "id": "s-0028",
   "nl": "Alsjeblieft. / Alstublieft.",
   "de": "Bitte. / Bitte schön.",
   "category": "Höflichkeit",
   "hint": "auch beim Überreichen; alstublieft = formell",
   "lesson": "l-0104"
  },
  {
