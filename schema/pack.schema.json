{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krakenhub123-web.github.io/Dutchies-content/schema/pack.schema.json",
  "title": "Dutchies Inhaltspaket",
  "description": "Ein Paket mit Lektionen, Wörtern und/oder Sätzen. Beschreibung: docs/CONTENT_FORMAT.md",
  "type": "object",
  "required": [
    "id",
    "title",
    "lessons"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Paket-ID, entspricht dem Dateinamen ohne .json"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "lessons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lesson"
      }
    },
    "words": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/word"
      }
    },
    "sentences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sentence"
      }
    },
    "prepositions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/preposition"
      }
    },
    "tenses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tense"
      }
    }
  },
  "$defs": {
    "lesson": {
      "type": "object",
      "required": [
        "id",
        "title",
        "type",
        "order"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^l-[0-9]{4,}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "words",
            "sentences"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "description": "Sortierung innerhalb des Typs (aufsteigend)"
        },
        "chapter": {
          "type": "string",
          "minLength": 1,
          "description": "Gruppierung auf dem Startbildschirm"
        },
        "retired": {
          "type": "boolean"
        }
      }
    },
    "example": {
      "type": "object",
      "required": [
        "nl",
        "de"
      ],
      "additionalProperties": false,
      "properties": {
        "nl": {
          "type": "string",
          "minLength": 1
        },
        "de": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "word": {
      "type": "object",
      "required": [
        "id",
        "nl",
        "de",
        "pos",
        "article",
        "examples",
        "lesson"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^w-[0-9]{4,}$"
        },
        "nl": {
          "type": "string",
          "minLength": 1
        },
        "de": {
          "type": "string",
          "minLength": 1
        },
        "pos": {
          "enum": [
            "noun",
            "verb",
            "vprep",
            "adj",
            "adv",
            "pron",
            "prep",
            "conj",
            "num",
            "art",
            "interj",
            "other"
          ],
          "description": "vprep = Verb + Präposition (z. B. wachten op)"
        },
        "article": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "de",
            "het",
            "de|het",
            null
          ]
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/example"
          }
        },
        "lesson": {
          "type": "string",
          "pattern": "^l-[0-9]{4,}$"
        },
        "phrases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "nl",
              "de",
              "example"
            ],
            "additionalProperties": false,
            "properties": {
              "nl": {
                "type": "string",
                "minLength": 1
              },
              "de": {
                "type": "string",
                "minLength": 1
              },
              "example": {
                "$ref": "#/$defs/example"
              }
            }
          }
        },
        "en": {
          "type": "string"
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "retired": {
          "type": "boolean"
        },
        "plural": {
          "type": [
            "string",
            "null"
          ],
          "description": "Pluralform (Dit/Deze-Trainer). Bei reinen Pluralwörtern = nl."
        },
        "articleMeaning": {
          "type": "boolean",
          "description": "true = der Artikel ändert die Bedeutung (z. B. het/de pad) → nicht in De/Het und Dit/Deze"
        },
        "prep": {
          "type": "string",
          "description": "nur vprep: Präposition(en), Varianten mit /"
        },
        "reflexive": {
          "enum": [
            "ja",
            "nein",
            "optional"
          ]
        },
        "level": {
          "type": "string",
          "description": "nur vprep: Stufe (basis, 2000-3000, …)"
        },
        "expr": {
          "type": "boolean",
          "description": "nur vprep: Ausdruck statt einfaches Verb (z. B. trots zijn op)"
        }
      }
    },
    "sentence": {
      "type": "object",
      "required": [
        "id",
        "nl",
        "de",
        "category",
        "hint",
        "lesson"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^s-[0-9]{4,}$"
        },
        "nl": {
          "type": "string",
          "minLength": 1
        },
        "de": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "lesson": {
          "type": "string",
          "pattern": "^l-[0-9]{4,}$"
        },
        "retired": {
          "type": "boolean"
        }
      }
    },
    "preposition": {
      "type": "object",
      "required": [
        "id",
        "nl",
        "answer",
        "de"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^p-[0-9]{4,}$"
        },
        "nl": {
          "type": "string",
          "minLength": 1,
          "pattern": "___"
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "description": "richtige Präposition, Varianten mit |"
        },
        "de": {
          "type": "string",
          "minLength": 1
        },
        "retired": {
          "type": "boolean"
        }
      }
    },
    "tense": {
      "type": "object",
      "required": [
        "id",
        "inf",
        "de",
        "pres",
        "past",
        "part",
        "aux",
        "obj"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^t-[0-9]{4,}$"
        },
        "inf": {
          "type": "string",
          "minLength": 1
        },
        "de": {
          "type": "string",
          "minLength": 1
        },
        "pres": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "ik, jij, hij/zij, wij/jullie/zij"
        },
        "past": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Imperfekt Singular, Plural"
        },
        "part": {
          "type": "string",
          "minLength": 1
        },
        "aux": {
          "type": "string",
          "pattern": "^(hebben|zijn)(\\|(hebben|zijn))?$"
        },
        "obj": {
          "type": "string"
        },
        "retired": {
          "type": "boolean"
        }
      }
    }
  }
}